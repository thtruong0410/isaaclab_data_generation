# Standalone workspace for IsaacLab demo generation.
# This file is sourced by scripts/*.sh. Override values here or via env vars.

# IsaacLab location.
ISAACLAB_ROOT="${ISAACLAB_ROOT:-/home/may3/IsaacLab}"

# Python used for metadata helpers and HDF5 merge checks.
# Leave empty to auto-detect from the active venv or PATH.
PYTHON_BIN="${PYTHON_BIN:-}"

# Python used by IsaacLab launcher. Leave empty to use PYTHON_BIN.
ISAAC_PYTHON_BIN="${ISAAC_PYTHON_BIN:-}"

# Keep all generated data in this standalone workspace.
DATA_ROOT="${DATA_ROOT:-$WORKSPACE_ROOT/data}"
LOG_ROOT="${LOG_ROOT:-$WORKSPACE_ROOT/logs}"

# Data generation defaults.
DEFAULT_RAW_DEMOS="${DEFAULT_RAW_DEMOS:-10}"
DEFAULT_MIMIC_DEMOS="${DEFAULT_MIMIC_DEMOS:-1000}"
TELEOP_DEVICE="${TELEOP_DEVICE:-keyboard}"
HEADLESS="${HEADLESS:-1}"
NUM_ENVS="${NUM_ENVS:-1}"

# Supported data-only tasks for this workspace.
TASKS="${TASKS:-open_door_normal open_door_sphere open_drawer_normal open_drawer_sphere close_door_normal close_door_sphere close_drawer_normal close_drawer_sphere}"
